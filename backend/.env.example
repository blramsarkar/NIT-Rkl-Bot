# ==============================================================================
# File: backend/.env.example
# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit it,
# and never put API keys in the widget JavaScript.
# ==============================================================================

# --- LLM providers ("groq" or "anthropic"); leave keys empty to run without an LLM
PRIMARY_LLM_PROVIDER=groq
GROQ_API_KEY=
DEFAULT_LLM_MODEL=llama-3.1-8b-instant
FALLBACK_LLM_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Database: leave unset for the local SQLite file in data/; use PostgreSQL in production
# DATABASE_URL=postgresql://nitrkl_admin:CHANGE_ME@localhost:5432/nitrkl_bot_db

# --- Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DIMENSION=384

# --- CORS: production must list only the official site ("*" is refused when ENVIRONMENT=production)
ALLOWED_ORIGINS=https://www.nitrkl.ac.in,https://nitrkl.ac.in
ENVIRONMENT=production
DEBUG=false

# --- Abuse & cost controls
RATE_LIMIT_PER_MINUTE=30
MAX_QUESTIONS_PER_USER_WINDOW=15
USER_RATE_WINDOW_MINUTES=10
MAX_QUERY_CHARS=500
DAILY_LLM_CALL_BUDGET=2000
# Set true only when running behind your own reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

# --- Admin view (/admin-ui/). Leave empty to disable admin. Use a long random value:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- Scraper allowlist & scheduled re-ingestion
SCRAPE_ALLOWED_DOMAINS=nitrkl.ac.in
REINGEST_INTERVAL_HOURS=12
CACHE_TTL_SECONDS=900
